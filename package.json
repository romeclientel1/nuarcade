{
  "name": "nuarcade",
  "version": "5.3.0",
  "description": "NuArcade — Modern arcade frontend for TeknoParrot and Visual Pinball X",
  "main": "src/main/index.js",
  "author": "Rome Clientel",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:renderer": "cd renderer && npm run dev",
    "dev:electron": "electron .",
    "build": "npm run build:renderer && electron-builder",
    "build:renderer": "cd renderer && npm run build",
    "build:win": "npm run build:renderer && electron-builder --win",
    "preview": "electron .",
    "test": "node --test src/main/*.test.js src/preload/*.test.js && cd renderer && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "png2icons": "^2.0.1",
    "svg2img": "^1.0.0-beta.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.nuarcade.app",
    "productName": "NuArcade",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/dist/**/*",
      "assets/**/*",
      "assets/installer/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/icon.ico",
      "installerHeaderIcon": "assets/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "assets/installer/folders.nsh"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "fast-xml-parser": "^5.8.0",
    "js-yaml": "^4.3.0",
    "pngjs": "^7.0.0"
  }
}
